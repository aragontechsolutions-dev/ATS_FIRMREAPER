<Project>
  <!-- Configuración común a todos los proyectos de FirmReaper. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>ATS</Company>
    <Product>FirmReaper</Product>
    <Version>1.1.0</Version>
    <!-- Permite compilar el proyecto WPF también desde Linux (no ejecutarlo). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Símbolos dentro de cada .dll/.exe: el .exe publicado sale sin archivos sueltos. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
