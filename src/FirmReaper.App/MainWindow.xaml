<Window x:Class="FirmReaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FirmReaper — firmware MStar (etapa 1: solo lectura)"
        Height="760" Width="1100" MinHeight="500" MinWidth="760"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="10">
        <!-- Barra de acciones -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnOpen" Content="Abrir .BIN…" Padding="14,5" Click="OnOpen" />
            <Button x:Name="BtnSave" Content="Guardar informe…" Padding="14,5" Margin="8,0,0,0" Click="OnSaveReport" IsEnabled="False" />
            <Button x:Name="BtnCopy" Content="Copiar informe" Padding="14,5" Margin="8,0,0,0" Click="OnCopyReport" IsEnabled="False" />
            <TextBlock x:Name="TxtBusy" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <!-- Resultado de la identificación -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Padding="10" CornerRadius="4" Margin="0,0,0,8" Background="#EEEEEE">
            <StackPanel>
                <TextBlock x:Name="TxtIdent" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"
                           Text="Abre un volcado .BIN de 4 MB (o arrástralo a la ventana). No se modifica nada." />
                <TextBlock x:Name="TxtFile" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#444" />
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="Comprobaciones">
                <DataGrid x:Name="GridChecks" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Comprobación" Binding="{Binding Title}" Width="260" />
                        <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Background" Value="#FFD9D9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Advertencia">
                                    <Setter Property="Background" Value="#FFF4CC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </TabItem>
            <TabItem Header="Recursos (TEL)">
                <DataGrid x:Name="GridTel" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=0x{0:X4}}" Width="90" />
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat=0x{0:X6}}" Width="110" />
                        <DataGridTextColumn Header="Longitud" Binding="{Binding Length, StringFormat=0x{0:X6}}" Width="110" />
                        <DataGridTextColumn Header="Compresión" Binding="{Binding Compression}" Width="130" />
                        <DataGridTextColumn Header="Contenido" Binding="{Binding Content}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Informe completo">
                <TextBox x:Name="TxtReport" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
