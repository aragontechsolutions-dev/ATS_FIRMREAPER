<Window x:Class="FirmReaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FirmReaper — firmware MStar"
        Height="780" Width="1120" MinHeight="520" MinWidth="780"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="10">
        <!-- Barra de acciones -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnOpen" Content="Abrir .BIN…" Padding="14,5" Click="OnOpen" />
            <Button x:Name="BtnSave" Content="Guardar informe…" Padding="14,5" Margin="8,0,0,0" Click="OnSaveReport" IsEnabled="False" />
            <Button x:Name="BtnCopy" Content="Copiar informe" Padding="14,5" Margin="8,0,0,0" Click="OnCopyReport" IsEnabled="False" />
            <TextBlock x:Name="TxtBusy" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <!-- Resultado de la identificación -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Padding="10" CornerRadius="4" Margin="0,0,0,8" Background="#EEEEEE">
            <StackPanel>
                <TextBlock x:Name="TxtIdent" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"
                           Text="Abre un volcado .BIN de 4 MB (o arrástralo a la ventana)." />
                <TextBlock x:Name="TxtFile" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#444" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <TabItem Header="Comprobaciones">
                <DataGrid x:Name="GridChecks" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Comprobación" Binding="{Binding Title}" Width="260" />
                        <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Background" Value="#FFD9D9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Advertencia">
                                    <Setter Property="Background" Value="#FFF4CC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="TabGenerate" Header="Generar">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtNoProfile" TextWrapping="Wrap" Foreground="#666"
                                   Text="Abre un firmware ORIGINAL reconocido para ver las modificaciones disponibles." />
                        <StackPanel x:Name="PanelProfile" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Perfil:" VerticalAlignment="Center" Width="120" />
                                <ComboBox x:Name="CmbProfile" MinWidth="520" DisplayMemberPath="Name" SelectionChanged="OnProfileChanged" />
                            </StackPanel>
                            <TextBlock x:Name="TxtProfileDesc" TextWrapping="Wrap" Margin="120,0,0,4" Foreground="#444" />
                            <TextBlock x:Name="TxtProfileWarn" TextWrapping="Wrap" Margin="120,0,0,8" Foreground="#B00020" FontWeight="SemiBold" />
                            <!-- Una fila por opción del perfil (se rellena desde el código) -->
                            <StackPanel x:Name="PanelOptions" />
                            <StackPanel Orientation="Horizontal" Margin="120,10,0,0">
                                <Button x:Name="BtnGenerate" Content="Generar…" Padding="18,6" FontWeight="SemiBold" Click="OnGenerate" />
                                <Button x:Name="BtnCancel" Content="Cancelar" Padding="14,6" Margin="8,0,0,0" Click="OnCancel" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Recursos (TEL)">
                <DataGrid x:Name="GridTel" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=0x{0:X4}}" Width="90" />
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat=0x{0:X6}}" Width="110" />
                        <DataGridTextColumn Header="Longitud" Binding="{Binding Length, StringFormat=0x{0:X6}}" Width="110" />
                        <DataGridTextColumn Header="Compresión" Binding="{Binding Compression}" Width="130" />
                        <DataGridTextColumn Header="Contenido" Binding="{Binding Content}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Informe completo">
                <TextBox x:Name="TxtReport" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
