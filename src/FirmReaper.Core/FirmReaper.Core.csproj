<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FirmReaper.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Catálogo de imágenes conocidas: va DENTRO del ensamblado (no se puede manipular desde fuera). -->
    <EmbeddedResource Include="Catalog\catalog.json" LogicalName="FirmReaper.Core.catalog.json" />
    <!-- Perfiles integrados: van dentro del ensamblado (no se pueden manipular desde fuera). -->
    <EmbeddedResource Include="Profiles\Builtin\*.json" LogicalName="FirmReaper.Core.Profiles.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FirmReaper.Core.Tests" />
  </ItemGroup>

</Project>
